<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Microsoft.Xna.Framework-compatible facade over CNA, for recompiling existing
      XNA 4.0 / FNA / MonoGame-era C# game source against CNA with minimal changes.
      See docs/xna-compatibility.md for what "compatible" does and does not mean here.
      Never references CNA.Interop directly -- see docs/architecture.md.
    </Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable Condition="'$(CnaPackageAcceptance)' != 'true'">false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CNA.Framework\CNA.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- XNA's <XnaProfile> -> RuntimeProfile resource; see the file. -->
    <None Include="build/CNA.XnaCompat.targets" Pack="true" PackagePath="build/;buildTransitive/" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generators a game's compilation runs (see build/CNA.XnaCompat.targets); this assembly
         does not run them, it carries them. -->
    <ProjectReference Include="..\CNA.XnaCompat.Generators\CNA.XnaCompat.Generators.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\CNA.XnaCompat.Generators\bin\$(Configuration)\netstandard2.0\CNA.XnaCompat.Generators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
