<Project>

  <!--
    XNA 4.0's runtime assemblies by their simple names and version, each holding nothing but type
    forwards to CNA.XnaCompat, as FNA's abi/ assemblies are for FNA. A library compiled against XNA
    (physics, animation, UI middleware shipped as a .dll) names "Microsoft.Xna.Framework,
    Version=4.0.0.0"; with these beside it the runtime resolves that name to CNA.XnaCompat's types,
    so the binary runs unchanged. They carry no public key: CNA.NET does not take Microsoft's
    identity. The compiler, which unlike the runtime compares public key tokens, sees such a library
    through the copy CNA.XnaCompat.targets makes of it (CnaRetargetXnaReferences). A game that
    references one also references the projects here that it names. Forwards.cs is generated by
    tools/xna-assemblies.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../CNA.XnaCompat/CNA.XnaCompat.csproj" />
  </ItemGroup>

</Project>
