<Project>
  <!--
    A CNA.NET game in a browser. Import from a Microsoft.NET.Sdk.WebAssembly project that
    references the CNA.NET assemblies; the page needs nothing but runMain() (Game.Run asks for
    animation frames itself).

    CNA is linked statically into dotnet.native.wasm, so this must be a native relink, compiled with
    the Emscripten of the project's own wasm-tools workload: scripts/Build-BrowserNative.sh builds
    and stages the archive this links. CnaBrowserNativeArchive points elsewhere if needed; the file
    must keep the name cna-native.a, the library name CNA.Interop's imports bind to.
  -->
  <PropertyGroup>
    <WasmBuildNative>true</WasmBuildNative>
    <!-- CNA's Emscripten exception ABI is the JS-lowered one (-fexceptions); .NET must match it. -->
    <WasmEnableExceptionHandling>false</WasmEnableExceptionHandling>
    <!-- CNA's static data alone is about 37 MB. -->
    <EmccInitialHeapSize Condition="'$(EmccInitialHeapSize)' == ''">67108864</EmccInitialHeapSize>
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2</EmccExtraLDFlags>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <CnaBrowserNativeArchive Condition="'$(CnaBrowserNativeArchive)' == ''">$(MSBuildThisFileDirectory)../../build-consumer/cna-native-browser-wasm/cna-native.a</CnaBrowserNativeArchive>
  </PropertyGroup>

  <!-- XNA StorageDevice's backing store in a browser: CNA mounts IDBFS at /cna-storage before Main
       from a pre-js staged beside the archive; without it every OpenContainer refuses with
       "Persistent browser storage is unavailable". -->
  <PropertyGroup>
    <_CnaBrowserStoragePreJs>$([System.IO.Path]::GetDirectoryName('$(CnaBrowserNativeArchive)'))/WebStoragePre.js</_CnaBrowserStoragePreJs>
    <EmccExtraLDFlags Condition="Exists('$(_CnaBrowserStoragePreJs)')">$(EmccExtraLDFlags) -lidbfs.js --pre-js &quot;$(_CnaBrowserStoragePreJs)&quot;</EmccExtraLDFlags>
  </PropertyGroup>

  <ItemGroup>
    <NativeFileReference Include="$(CnaBrowserNativeArchive)" />
    <!-- The content manager creates readers by reflection from the type names an XNB declares,
         which the trimmer cannot see: an untrimmed CNA.NET keeps them constructible. (Turning
         trimming off altogether leaves .NET 11's relinked runtime out of step with its CoreLib.)
         A game whose content names its own readers roots its own assembly the same way. -->
    <TrimmerRootAssembly Include="CNA.Interop;CNA.Framework;CNA.XnaCompat" />
    <!-- The .NET APIs the browser runtime leaves unimplemented (System.IO.IsolatedStorage). -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/CNA.BrowserCompat/CNA.BrowserCompat.csproj" />
    <StaticWebAssetFingerprintPattern Include="CnaBrowserScripts" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <Target Name="CnaBrowserRequireNativeArchive" BeforeTargets="Build">
    <Error Condition="!Exists('$(CnaBrowserNativeArchive)')"
           Text="No CNA browser archive at $(CnaBrowserNativeArchive). Build it with scripts/Build-BrowserNative.sh." />
  </Target>
  <!-- The page and its start-up script, for a project that brings none of its own. -->
  <ItemGroup Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/index.html')">
    <Content Include="$(MSBuildThisFileDirectory)wwwroot/*" Link="wwwroot/%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    A game's Content in the page's file system, at Content/... beside the game: set
    CnaGameContentDirectory to the game's Content folder. The SDK puts only static web assets there,
    and a file linked in from outside the project conflicts with itself in .NET 11's ComputeWasmVfs
    (it removes the original by its relative item spec, the asset's identity being the full path), so
    the files are copied under the project's own wwwroot/Content as the build starts.
  -->
  <Target Name="CnaStageGameContent" BeforeTargets="ResolveProjectStaticWebAssets"
          Condition="'$(CnaGameContentDirectory)' != ''">
    <ItemGroup>
      <_CnaGameContent Include="$(CnaGameContentDirectory)/**" />
    </ItemGroup>
    <Copy SourceFiles="@(_CnaGameContent)" SkipUnchangedFiles="true"
          DestinationFiles="@(_CnaGameContent->'$(MSBuildProjectDirectory)/wwwroot/Content/%(RecursiveDir)%(Filename)%(Extension)')" />
    <ItemGroup>
      <Content Remove="wwwroot/Content/**" />
      <Content Include="@(_CnaGameContent->'wwwroot/Content/%(RecursiveDir)%(Filename)%(Extension)')" />
      <WasmFilesToIncludeInFileSystem Include="@(_CnaGameContent->'Content/%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <!-- A game's System.IO.IsolatedStorage binds to CNA.BrowserCompat, not to the runtime's stub. -->
  <Import Project="$(MSBuildThisFileDirectory)../../src/CNA.BrowserCompat/build/CNA.BrowserCompat.targets" />
</Project>
