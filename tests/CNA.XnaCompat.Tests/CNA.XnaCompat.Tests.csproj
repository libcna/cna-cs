<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- As an XNA game project says it; RuntimeProfileTests reads the resource this embeds. -->
    <XnaProfile>HiDef</XnaProfile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CNA.XnaCompat\CNA.XnaCompat.csproj" />
    <ProjectReference Include="..\..\src\CNA.WindowsFormsCompat\CNA.WindowsFormsCompat.csproj" />
    <!-- XnaBinaryLibraryTests: a library compiled against XNA 4.0, and the XNA identities it names. -->
    <ProjectReference Include="..\..\src\XnaAssemblies\Microsoft.Xna.Framework\Microsoft.Xna.Framework.csproj" />
    <ProjectReference Include="..\..\src\XnaAssemblies\Microsoft.Xna.Framework.Game\Microsoft.Xna.Framework.Game.csproj" />
    <ProjectReference Include="..\..\src\XnaAssemblies\Microsoft.Xna.Framework.Graphics\Microsoft.Xna.Framework.Graphics.csproj" />
    <Reference Include="XnaBinaryLibrary" HintPath="..\fixtures\xna-binary-library\XnaBinaryLibrary.dll" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\CNA.XnaCompat.CompileProbe\MathBehaviorCorpus.cs" Link="MathBehaviorCorpus.cs" />
    <Compile Include="..\CNA.XnaCompat.CompileProbe\InputBehaviorCorpus.cs" Link="InputBehaviorCorpus.cs" />
  </ItemGroup>

  <Import Project="..\..\src\CNA.XnaCompat\build\CNA.XnaCompat.targets" />

</Project>
